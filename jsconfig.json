{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@css/*": ["src/visuals/css/*"],
      "@fonts/*": ["src/visuals/fonts/*"],
      "@img/*": ["src/visuals/img/*"],
      "@utils/*": ["src/utils/*"],
      "@services/*": ["src/services/*"],
      "@ui/*": ["src/ui/*"],
      "@deliveryPage/*": ["src/pages/DeliveryPage/*"],
      "@pickupModule/*": ["src/pages/DeliveryPage/modules/Pickup/*"],
      "@deliveryModule/*": ["src/pages/DeliveryPage/modules/Delivery/*"]
    },
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false
  },
  "exclude": ["node_modules", "dist"]
}
